{
  "name": "japan-travel-map-guide",
  "private": true,
  "version": "1.0.0",
  "description": "日本在地商店、旅館導覽地圖 - 以車站為核心查找東橫INN與在地生活圈",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/datagenerate.js",
    "build": "node scripts/datagenerate.js && vite build",
    "preview": "vite preview",
    "crawl:toyoko": "node scripts/crawl_toyoko.js",
    "crawl:url": "node scripts/crawl_url.js",
    "sync:sheet": "node scripts/sync_to_sheet.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "csv-parser": "^3.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
